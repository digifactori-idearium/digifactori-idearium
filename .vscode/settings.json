{
  "workbench.colorCustomizations": {
    "activityBarBadge.background": "#ff6ec7",
    "activityBarBadge.foreground": "#ffffff",
    "activityBar.activeBorder": "#6f6cff",
    "statusBarItem.hoverBackground": "#b086ff33",
    "commandCenter.border": "#6f6cff99",
    "sash.hoverBorder": "#ff6ec7",
    "editorCursor.foreground": "#ff6ec7",
    "editorLineNumber.activeForeground": "#b086ff",
    "editorBracketHighlight.foreground1": "#6b42c6",
    "editorBracketHighlight.foreground2": "#b086ff",
    "editorBracketHighlight.foreground3": "#6f6cff",
    "editorSuggestWidget.highlightForeground": "#ff6ec7",
    "tab.activeBorderTop": "#6f6cff",
    "tab.activeModifiedBorder": "#ff6ec7",
    "panel.border": "#6b42c6",
    "sideBarSectionHeader.border": "#b086ff55"
  },
  "peacock.color": "#1a1f15",

  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.format.enable": true,
  "eslint.codeActionsOnSave.mode": "all",
  "eslint.useFlatConfig": true,

  "editor.defaultFormatter": "dbaeumer.vscode-eslint",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },

  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "sonarlint.connectedMode.project": {
    "connectionId": "digifactori-idearium",
    "projectKey": "digifactori-idearium"
  }
}
