// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  INTERN
  SUPERVISOR
  ADMIN
}

enum IntegrationType {
  MODEL_3D
  SOUND
  IMAGE
  OTHER
}

enum AssetCategory {
  FOOD_AND_DRINK
  CLUTTER
  WEAPONS
  TRANSPORT
  FURNITURE_AND_DECOR
  OBJECTS
  NATURE
  ANIMALS
  BUILDINGS
  PEOPLE_AND_CHARACTERS
  SCENES_AND_LEVELS
  OTHER
}

enum StorageProvider {
  S3
  R2
  GCS
  AZURE
  MINIO
  LOCAL
}

// ============================================================
// AUTH & IDENTITY
// ============================================================

// Account layer — authentication, roles, and owned content
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  first_name  String
  last_name   String
  password    String
  role        Role
  isActive    Boolean  @default(true)

  // Owned content
  profile     Profile?
  ideoramas   Ideorama[]
  voxelModels VoxelModel[]
  documents   Document[]
  ideas       Idea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Social/public identity layer — follows, likes, avatar, bio
model Profile {
  id           String  @id @default(cuid())
  userId       String  @unique
  pseudo       String  @unique
  avatar       String?
  bio          String?
  voiceButtons Boolean @default(true)

  // Social
  followers     Follow[]        @relation("UserFollowers")
  following     Follow[]        @relation("UserFollowing")
  ideoramaLiked IdeoramaLikes[] @relation("ideoramaLiked")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Join table for follower/following relationships between profiles
model Follow {
  follower   Profile @relation("UserFollowing", fields: [followerId], references: [userId], onDelete: Cascade)
  followerId String

  following  Profile @relation("UserFollowers", fields: [followedId], references: [userId], onDelete: Cascade)
  followedId String

  @@id([followerId, followedId])
}

// ============================================================
// CONTENT
// ============================================================

// 3D scene stored as serialized string
model Ideorama {
  id       String  @id @default(cuid())
  name     String  @default("New Ideorama")
  isPublic Boolean @default(true)
  scene    String  // storage key of the ideorama

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  likers IdeoramaLikes[] @relation("likers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Many-to-many: profiles liking ideorama
model IdeoramaLikes {
  profile    Profile  @relation("ideoramaLiked", fields: [userId], references: [userId], onDelete: Cascade)
  userId     String
  ideorama   Ideorama @relation("likers", fields: [ideoramaId], references: [id], onDelete: Cascade)
  ideoramaId String

  @@id([ideoramaId, userId])
}

// Kanbam Idea type
model Idea {
  id     String @id @default(cuid())
  data   Json

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Text Editor Saved document
model Document {
  id        String  @id @default(cuid())
  title     String  @default("Sans titre")
  content   String  @default("")
  json      Json?
  wordCount Int     @default(0)
  emoji     String  @default("📝")
  color     String  @default("#a78bfa")

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 3D voxel model
model VoxelModel {
  id    String @id @default(cuid())
  name  String @default("New Voxel Model")
  model String // storage key of the model

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// ASSETS
// ============================================================

// Media assets (3D models, sounds, images)
model Asset {
  id        String          @id @default(cuid())
  name      String
  type      IntegrationType @default(OTHER)
  category  AssetCategory   @default(OTHER)
  tags      String[]
  file      String  // storage key of the asset
  thumbnail String? // storage key of the asset preview

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// SETTINGS & INTEGRATIONS
// ============================================================

// Organization settings
model Setting {
  id              Int  @id @default(1)
  orgCode         Int  @default(202026)
  orgParentalCode Int  @default(2026)

  storage      CloudStorage?
  integrations Integration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cloud storage configuration for asset uploads
model CloudStorage {
  id        Int             @id @default(1)
  name      String?
  provider  StorageProvider @default(LOCAL)
  region    String?
  endpoint  String?
  bucket    String?
  accessKey String?
  secretKey String?
  publicUrl String?

  settingId Int     @unique
  setting   Setting @relation(fields: [settingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// External service integrations (APIs, asset sources, etc.)
model Integration {
  id           String          @id @default(cuid())
  name         String
  url          String
  type         IntegrationType
  key          String?
  isActive     Boolean         @default(true)
  fieldMapping Json            @default("{}")

  settingId Int
  setting   Setting @relation(fields: [settingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}