// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CHILD
  SUPERVISOR
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  first_name String
  last_name  String
  password  String
  role      Role
  profil   Profil?  
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt
}

model Profil {
  id        String    @id @default(cuid())
  userId    String   @unique
  pseudo    String   @unique
  avatar    String?
  bio       String?
  followers  Follows[]   @relation("followers")
  following  Follows[]  @relation("following")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
}

model Follows {
  followers   Profil @relation("followers", fields: [followedById], references: [id])
  followedById String
  following    Profil @relation("following", fields: [followingId], references: [id])
  followingId  String

  @@id([followingId, followedById])
}
