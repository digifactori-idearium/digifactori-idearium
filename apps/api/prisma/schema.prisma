// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CHILD
  SUPERVISOR
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  first_name    String
  last_name     String
  password      String
  parental_code String?
  role          Role
  profil        Profile?
  ideoramas     Ideorama[]
  voxelModels   VoxelModel[]
  documents     Document[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Profile {
  id            String          @id @default(cuid())
  userId        String          @unique
  pseudo        String          @unique
  avatar        String?
  bio           String?
  followers     Follows[]       @relation("followers")
  following     Follows[]       @relation("following")
  ideoramaLiked IdeoramaLikes[] @relation("ideoramaLiked")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id])
}

model Follows {
  followers    Profile @relation("followers", fields: [followedById], references: [id])
  followedById String
  following    Profile @relation("following", fields: [followingId], references: [id])
  followingId  String

  @@id([followingId, followedById])
}

// use metadata
model Ideorama {
  id          String  @id @default(cuid())
  name        String  @default("New Ideorama")
  description String?
  theme       String  @default("black-orange")
  brightness  String  @default("bright")
  isPublic    Boolean @default(true)

  backgroundColor String @default("#f0d400")
  leftWallColor   String @default("#f45405")
  rightWallColor  String @default("#e80606")
  floorColor      String @default("#100101")

  model String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  likers IdeoramaLikes[] @relation("likers")

  voxels Voxel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IdeoramaLikes {
  profile    Profile  @relation("ideoramaLiked", fields: [userId], references: [id])
  userId     String
  ideorama   Ideorama @relation("likers", fields: [ideoramaId], references: [id])
  ideoramaId String

  @@id([ideoramaId, userId])
}

model Voxel {
  id    String @id @default(cuid())
  x     Int
  y     Int
  z     Int
  color String

  ideoramaId String
  ideorama   Ideorama @relation(fields: [ideoramaId], references: [id])

  createdAt DateTime @default(now())
}

model VoxelModel {
  id        String   @id @default(cuid())
  name      String   @default("New Voxel Model")
  model     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Document {
  id        String   @id @default(cuid())
  title     String   @default("Sans titre")
  content   String   @default("") 
  json      Json?
  wordCount Int      @default(0)
  emoji     String   @default("📝")
  color     String   @default("#a78bfa")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ASSETS
enum IntegrationType {
  ASSET
  MUSIC
  OTHER
}



model Setting {
  id           Int           @id @default(1)
  storeName    String
  storeURL     String
  storeKey     String?
  integrations Integration[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Integration {
  id           String          @id @default(cuid())
  settingId    Int
  setting      Setting         @relation(fields: [settingId], references: [id])
  name         String
  url          String
  type         IntegrationType
  key          String?          
  isActive     Boolean         @default(true)
  fieldMapping Json            @default("{}")  
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

