// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  INTERN
  SUPERVISOR
  ADMIN
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  first_name  String
  last_name   String
  password    String
  role        Role
  isActive    Boolean      @default(true)
  profile     Profile?
  ideoramas   Ideorama[]
  voxelModels VoxelModel[]
  documents   Document[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Profile {
  id            String          @id @default(cuid())
  userId        String          @unique
  pseudo        String          @unique
  avatar        String?
  bio           String?
  followers     Follow[]        @relation("UserFollowers")
  following     Follow[]        @relation("UserFollowing")
  ideoramaLiked IdeoramaLikes[] @relation("ideoramaLiked")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  follower   Profile @relation("UserFollowing", fields: [followerId], references: [userId], onDelete: Cascade)
  followerId String

  following  Profile @relation("UserFollowers", fields: [followedId], references: [userId], onDelete: Cascade)
  followedId String

  @@id([followerId, followedId])
}

// use metadata
model Ideorama {
  id       String  @id @default(cuid())
  name     String  @default("New Ideorama")
  isPublic Boolean @default(true)

  scene Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  likers IdeoramaLikes[] @relation("likers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IdeoramaLikes {
  profile    Profile  @relation("ideoramaLiked", fields: [userId], references: [userId], onDelete: Cascade)
  userId     String
  ideorama   Ideorama @relation("likers", fields: [ideoramaId], references: [id], onDelete: Cascade)
  ideoramaId String

  @@id([ideoramaId, userId])
}


model VoxelModel {
  id        String   @id @default(cuid())
  name      String   @default("New Voxel Model")
  model     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id        String   @id @default(cuid())
  title     String   @default("Sans titre")
  content   String   @default("")
  json      Json?
  wordCount Int      @default(0)
  emoji     String   @default("📝")
  color     String   @default("#a78bfa")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ASSETS
enum IntegrationType {
  MODEL_3D
  SOUND
  IMAGE
  OTHER
}

enum AssetCategory {
  FOOD_AND_DRINK
  CLUTTER
  WEAPONS
  TRANSPORT
  FURNITURE_AND_DECOR
  OBJECTS
  NATURE
  ANIMALS
  BUILDINGS
  PEOPLE_AND_CHARACTERS
  SCENES_AND_LEVELS
  OTHER
}

model Setting {
  id              Int           @id @default(1)
  orgCode         Int           @default(202026)
  orgParentalCode Int           @default(2026)
  storage         CloudStorage?
  integrations    Integration[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum StorageProvider {
  S3
  R2
  GCS
  AZURE
  MINIO
  LOCAL
}

model CloudStorage {
  id        Int             @id @default(1)
  name      String?
  provider  StorageProvider @default(LOCAL)
  region    String?
  endpoint  String?
  bucket    String?
  accessKey String?
  secretKey String?
  publicUrl String?

  settingId Int     @unique
  setting   Setting @relation(fields: [settingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Integration {
  id           String          @id @default(cuid())
  settingId    Int
  setting      Setting         @relation(fields: [settingId], references: [id])
  name         String
  url          String
  type         IntegrationType
  key          String?
  isActive     Boolean         @default(true)
  fieldMapping Json            @default("{}")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Asset {
  id       String          @id @default(cuid())
  name     String
  type     IntegrationType @default(OTHER)
  category AssetCategory   @default(OTHER)
  tags     String[]

  file      String
  thumbnail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
