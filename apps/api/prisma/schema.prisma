// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CHILD
  SUPERVISOR
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  first_name     String
  last_name      String
  password       String
  parental_codee String?
  role           Role
  profil         Profile?
  ideoramas      Ideorama[]
  voxelModels    VoxelModel[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Profile {
  id            String          @id @default(cuid())
  userId        String          @unique
  pseudo        String          @unique
  avatar        String?
  bio           String?
  followers     Follows[]       @relation("followers")
  following     Follows[]       @relation("following")
  ideoramaLiked IdeoramaLikes[] @relation("ideoramaLiked")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id])
}

model Follows {
  followers    Profile @relation("followers", fields: [followedById], references: [id])
  followedById String
  following    Profile @relation("following", fields: [followingId], references: [id])
  followingId  String

  @@id([followingId, followedById])
}

// use metadata
model Ideorama {
  id       String  @id @default(cuid())
  name     String  @default("New Ideorama")
  isPublic Boolean @default(true)

  model String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  likers IdeoramaLikes[] @relation("likers")

  voxels Voxel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IdeoramaLikes {
  profile    Profile  @relation("ideoramaLiked", fields: [userId], references: [id])
  userId     String
  ideorama   Ideorama @relation("likers", fields: [ideoramaId], references: [id])
  ideoramaId String

  @@id([ideoramaId, userId])
}

model Voxel {
  id    String @id @default(cuid())
  x     Int
  y     Int
  z     Int
  color String

  ideoramaId String
  ideorama   Ideorama @relation(fields: [ideoramaId], references: [id])

  createdAt DateTime @default(now())
}

model VoxelModel {
  id        String   @id @default(cuid())
  name      String   @default("New Voxel Model")
  model     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
