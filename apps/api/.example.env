# Créez un fichier .env dans le même répertoire/dossier racine et met tes variable propre selon toi

# le port sur lequel tourne le bakcend 
PORT=3001

# Enviroment de l'application : 'development', 'production', 'test'.
NODE_ENV=development

# Le lien du backend en ligne; le choffre apres correspond au port en local
API_BASE_URL=http://localhost:3001 

# Le lien du frontend en ligne
FRONTEND_URL=digifactori-idearium.netlify.app

# L'URL de la base de donne postgres, remplace par des valeur reel
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/idearium?schema=public"

# La clef de chiffrement de JWT(Json Web Token), minimun 32 character
JWT_SECRET="......."

# le code que l'admin utilse pour s'enregistre
ADMIN_CODE=505050

# le clef API pour l'envoie de mail, creation d'un compte resend et generation de la clef API et copier ici
RESEND_API_KEY=..........

# le mail de l'envoyeur avec resent;  pas gmail; c'est selon ton domaine  (unamur.be, digifactory.be) 
EMAIL_FROM=moi@domain.com




